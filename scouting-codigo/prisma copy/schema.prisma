generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(SCOUT)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  reports       ScoutingReport[]
  favorites     PlayerFavorite[]
  comparisons   PlayerComparison[]
}

enum UserRole {
  ADMIN
  SCOUT
  ANALYST
}

model Player {
  id              String   @id @default(cuid())
  firstName       String
  lastName        String
  fullName        String
  dateOfBirth     DateTime
  age             Int
  nationality     String
  height          Float?
  weight          Float?
  preferredFoot   Foot     @default(RIGHT)
  primaryPosition Position
  secondaryPositions Position[]
  currentClub     String
  marketValue     Float?
  contractUntil   DateTime?
  photoUrl        String?
  shirtNumber     Int?

  stats           PlayerStats?
  performances    Performance[]
  reports         ScoutingReport[]
  favorites       PlayerFavorite[]
  comparisonsA    PlayerComparison[] @relation("PlayerA")
  comparisonsB    PlayerComparison[] @relation("PlayerB")
  tags            PlayerTag[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([fullName])
  @@index([primaryPosition])
  @@index([currentClub])
  @@index([nationality])
}

enum Foot {
  LEFT
  RIGHT
  BOTH
}

enum Position {
  GK
  CB
  LB
  RB
  DM
  CM
  AM
  LW
  RW
  SS
  ST
}

model PlayerStats {
  id                    String   @id @default(cuid())
  playerId              String   @unique
  player                Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  overallRating         Int      @default(50)

  finishing             Int      @default(50)
  shotPower             Int      @default(50)
  longShots             Int      @default(50)
  positioning           Int      @default(50)
  penalties             Int      @default(50)

  vision                Int      @default(50)
  crossing              Int      @default(50)
  shortPassing          Int      @default(50)
  longPassing           Int      @default(50)
  curve                 Int      @default(50)
  freeKickAccuracy      Int      @default(50)

  marking               Int      @default(50)
  standingTackle        Int      @default(50)
  slidingTackle         Int      @default(50)
  interceptions         Int      @default(50)
  heading               Int      @default(50)

  acceleration          Int      @default(50)
  sprintSpeed           Int      @default(50)
  agility               Int      @default(50)
  balance               Int      @default(50)
  jumping               Int      @default(50)
  stamina               Int      @default(50)
  strength              Int      @default(50)
  aggression            Int      @default(50)

  pace                  Int      @default(50)

  dribbling             Int      @default(50)
  ballControl           Int      @default(50)
  reactions             Int      @default(50)
  composure             Int      @default(50)

  diving                Int?     @default(50)
  handling              Int?     @default(50)
  kicking               Int?     @default(50)
  reflexes              Int?     @default(50)
  speed                 Int?     @default(50)
  positioningGk         Int?     @default(50)

  updatedAt             DateTime @updatedAt
}

model Performance {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  season        String
  competition   String
  matchesPlayed Int      @default(0)
  minutesPlayed Int      @default(0)
  goals         Int      @default(0)
  assists       Int      @default(0)
  xG            Float?   @default(0)
  xA            Float?   @default(0)
  yellowCards   Int      @default(0)
  redCards      Int      @default(0)
  avgRating     Float?   @default(0)

  createdAt     DateTime @default(now())

  @@index([playerId, season])
}

model ScoutingReport {
  id            String   @id @default(cuid())
  playerId      String
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  scoutId       String
  scout         User     @relation(fields: [scoutId], references: [id])

  strengths     String   @db.Text
  weaknesses    String   @db.Text
  potential     Int      @default(50)
  playStyle     String   @db.Text
  comparison    String?  @db.Text
  observations  String   @db.Text
  overallScore  Int      @default(50)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([playerId])
  @@index([scoutId])
}

model PlayerFavorite {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([playerId, userId])
}

model PlayerComparison {
  id          String   @id @default(cuid())
  playerAId   String
  playerA     Player   @relation("PlayerA", fields: [playerAId], references: [id])
  playerBId   String
  playerB     Player   @relation("PlayerB", fields: [playerBId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([playerAId, playerBId, userId])
}

model Tag {
  id          String       @id @default(cuid())
  name        String       @unique
  color       String       @default("#3B82F6")
  players     PlayerTag[]
  createdAt   DateTime     @default(now())
}

model PlayerTag {
  playerId    String
  player      Player       @relation(fields: [playerId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([playerId, tagId])
}
